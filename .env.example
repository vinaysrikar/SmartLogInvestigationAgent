# LLM Configuration (Optional - The Agent features an automatic Smart Fallback Engine if no key is provided)
LLM_PROVIDER=offline # Options: gemini, openai, ollama, offline
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=gemini-1.5-flash # or gpt-4o, llama3, etc.

# Agent Configuration
AGENT_MAX_ITERATIONS=10
ANOMALY_Z_THRESHOLD=2.5
TIME_WINDOW_MINUTES=5
